# ============================================================
# Logging Stack — Environment Variables
# Copy to .env and fill in secrets. Never commit .env.
# ============================================================

# ── Grafana ───────────────────────────────────────────────────
# Strong password: openssl rand -base64 32
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# The externally-accessible URL (used in alert notification links)
GRAFANA_ROOT_URL=https://grafana.example.com
GRAFANA_DOMAIN=grafana.example.com

# ── Alerting ──────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE/ME
ALERT_EMAIL_TO=ops@example.com

# ── App container labels (referenced in fluent-bit.conf) ──────
# These should be set as Docker labels on your app service,
# not as env vars. Shown here for documentation.
# labels:
#   app: myapp
#   env: production
